diff --git a/ledger.py b/ledger.py
index 541518a..8c7e2d1 100644
--- a/ledger.py
+++ b/ledger.py
@@ -11,6 +11,12 @@ class Ledger:
         self.history: list[tuple[str, str, int]] = []
 
     def transfer(self, src: str, dst: str, amount: int) -> None:
+        if type(amount) is not int or amount <= 0:
+            raise LedgerError("amount must be a positive integer")
+        if src not in self.balances or dst not in self.balances:
+            raise LedgerError("unknown account")
+        if self.balances[src] < amount:
+            raise LedgerError("insufficient funds")
         self.balances[src] -= amount
         self.balances[dst] += amount
         self.history.append((src, dst, amount))
